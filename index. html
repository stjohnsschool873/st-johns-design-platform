
<!DOCTYPE html>
<html lang="ml">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>St John's School Poster Creator</title>

<link href="https://fonts.googleapis.com/css2?family=Manjari&family=Noto+Sans+Malayalam&family=Gayathri&family=Chilanka&family=Baloo+Chettan+2&family=Kavivanar&family=Roboto&family=Poppins:wght@400;700&family=Playfair+Display&display=swap" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
* { box-sizing:border-box; }

body {
  margin:0;
  padding:18px;
  background:#10182b;
  color:white;
  font-family:Poppins,sans-serif;
}

h1 {
  text-align:center;
  color:#ffd166;
}

.editor {
  max-width:600px;
  margin:auto;
}

input, textarea, select, button {
  width:100%;
  padding:13px;
  margin:7px 0;
  border-radius:9px;
  border:0;
  font-size:16px;
}

button {
  background:#ffd166;
  font-weight:bold;
}

.poster {
  width:100%;
  min-height:500px;
  margin-top:20px;
  padding:30px 20px;
  background:linear-gradient(135deg,#6a11cb,#2575fc);
  color:white;
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  overflow-wrap:anywhere;
}

.poster h2 { font-size:32px; }
.poster p { font-size:20px; }

#photoPreview {
  max-width:100%;
  max-height:220px;
  object-fit:contain;
  margin:10px auto;
}
</style>
</head>

<body>

<div class="editor">

<h1>🎨 POSTER CREATOR</h1>
<p style="text-align:center">ST JOHN'S SCHOOL</p>

<label>Poster Heading</label>
<input id="heading" value="നമ്മുടെ സ്കൂൾ">

<label>Description</label>
<textarea id="description">നിങ്ങളുടെ സന്ദേശം ഇവിടെ എഴുതുക</textarea>

<label>Your Name</label>
<input id="author" placeholder="Enter your name">

<label>Select Font</label>
<select id="font">
<option value="Manjari">Manjari</option>
<option value="Noto Sans Malayalam">Noto Sans Malayalam</option>
<option value="Gayathri">Gayathri</option>
<option value="Chilanka">Chilanka</option>
<option value="Baloo Chettan 2">Baloo Chettan 2</option>
<option value="Kavivanar">Kavivanar</option>
<option value="Poppins">Poppins</option>
<option value="Roboto">Roboto</option>
<option value="Playfair Display">Playfair Display</option>
</select>

<label>Poster Background Colour</label>
<input type="color" id="colour" value="#6a11cb">

<label>Upload Image</label>
<input type="file" id="photo" accept="image/*">

<div class="poster" id="poster">
<h2 id="outHeading">നമ്മുടെ സ്കൂൾ</h2>
<img id="photoPreview" hidden>
<p id="outDescription">നിങ്ങളുടെ സന്ദേശം ഇവിടെ എഴുതുക</p>
<h3 id="outAuthor"></h3>
</div>

<button onclick="downloadPoster()">⬇ Download Poster</button>

</div>

<script>
const $ = id => document.getElementById(id);

function updatePoster() {
  $("outHeading").textContent = $("heading").value;
  $("outDescription").textContent = $("description").value;
  $("outAuthor").textContent = $("author").value;
  $("poster").style.background = $("colour").value;
  $("poster").style.fontFamily =
    '"' + $("font").value + '", sans-serif';
}

["heading","description","author","colour","font"].forEach(id => {
  $(id).addEventListener("input", updatePoster);
  $(id).addEventListener("change", updatePoster);
});

$("photo").addEventListener("change", e => {
  const file = e.target.files[0];
  if (!file) return;
  $("photoPreview").src = URL.createObjectURL(file);
  $("photoPreview").hidden = false;
});

async function downloadPoster() {
  await document.fonts.ready;
  const canvas = await html2canvas($("poster"), {
    scale:2,
    useCORS:true
  });
  const link = document.createElement("a");
  link.download = "School-Poster.png";
  link.href = canvas.toDataURL("image/png");
  link.click();
}

updatePoster();
</script>

</body>
</html>
