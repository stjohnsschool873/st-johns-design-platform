
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>St John's Poster Maker</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#eef1f8;
  color:#17213a;
}
header{
  background:#172554;
  color:white;
  padding:22px 15px;
  text-align:center;
}
header h2{margin:0}
header p{margin:7px 0 0;color:#cbd5e1}
.container{
  max-width:950px;
  margin:20px auto;
  padding:15px;
}
.editor{
  background:white;
  padding:20px;
  border-radius:15px;
  box-shadow:0 3px 15px #0001;
}
label{
  display:block;
  margin:13px 0 6px;
  font-weight:bold;
}
input,textarea,select{
  width:100%;
  padding:12px;
  border:1px solid #ccd3e0;
  border-radius:8px;
  font-size:15px;
}
textarea{height:100px;resize:vertical}
.colors{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.colors input{height:45px;padding:4px}
button{
  border:0;
  border-radius:9px;
  padding:14px;
  font-size:15px;
  font-weight:bold;
  cursor:pointer;
}
.download{
  width:100%;
  background:#2563eb;
  color:white;
  margin-top:18px;
}
.preview-title{
  text-align:center;
  margin:25px 0 12px;
}
canvas{
  width:100%;
  height:auto;
  display:block;
  background:white;
  border-radius:5px;
  box-shadow:0 4px 18px #0002;
}
footer{
  text-align:center;
  padding:20px;
  color:#64748b;
}
</style>
</head>

<body>

<header>
<h2>ST. JOHN'S SCHOOL</h2>
<p>Creative Poster Design Studio</p>
</header>

<div class="container">
<div class="editor">

<h3>🎨 Create Your Poster</h3>

<label>School Name</label>
<input id="school" value="ST. JOHN'S SCHOOL">

<label>Poster Title</label>
<input id="title" value="CANCER AWARENESS">

<label>Subtitle</label>
<input id="subtitle" value="FIGHT CANCER, SPREAD HOPE">

<label>Poster Description</label>
<textarea id="body">Cancer awareness is the first step towards prevention and early detection. Spread knowledge, support cancer fighters and encourage healthy living.</textarea>

<label>Footer Text</label>
<input id="footer" value="TOGETHER WE CAN MAKE A DIFFERENCE">

<label>Choose Font</label>
<select id="font">
<option value="Arial">Arial</option>
<option value="Georgia">Georgia</option>
<option value="Verdana">Verdana</option>
<option value="Trebuchet MS">Trebuchet MS</option>
<option value="Times New Roman">Times New Roman</option>
</select>

<div class="colors">
<div>
<label>Background Colour</label>
<input type="color" id="bg" value="#10234f">
</div>
<div>
<label>Text Colour</label>
<input type="color" id="fg" value="#ffffff">
</div>
</div>

<label>Accent Colour</label>
<input type="color" id="accent" value="#ffcc55">

<button class="download" onclick="downloadPoster()">
⬇ DOWNLOAD A4 POSTER
</button>

</div>

<h3 class="preview-title">Live Poster Preview</h3>
<canvas id="poster" width="1240" height="1754"></canvas>

</div>

<footer>
© 2026 ST. JOHN'S SCHOOL | Poster Maker
</footer>

<script>
const ids=["school","title","subtitle","body","footer","font","bg","fg","accent"];

function draw(){
 const c=document.getElementById("poster");
 const ctx=c.getContext("2d");
 const W=c.width,H=c.height;

 const school=document.getElementById("school").value;
 const title=document.getElementById("title").value;
 const subtitle=document.getElementById("subtitle").value;
 const body=document.getElementById("body").value;
 const footer=document.getElementById("footer").value;
 const font=document.getElementById("font").value;
 const bg=document.getElementById("bg").value;
 const fg=document.getElementById("fg").value;
 const accent=document.getElementById("accent").value;

 ctx.fillStyle=bg;
 ctx.fillRect(0,0,W,H);

 ctx.strokeStyle=accent;
 ctx.lineWidth=18;
 ctx.strokeRect(35,35,W-70,H-70);

 ctx.textAlign="center";
 ctx.fillStyle=accent;
 ctx.font="bold 48px "+font;
 ctx.fillText(school.toUpperCase(),W/2,180);

 ctx.fillRect(180,230,W-360,7);

 ctx.fillStyle=fg;
 ctx.font="bold 82px "+font;
 wrap(title.toUpperCase(),W/2,510,950,105);

 ctx.fillStyle=accent;
 ctx.font="bold 43px "+font;
 wrap(subtitle,W/2,750,950,65);

 ctx.fillStyle=fg;
 ctx.font="36px "+font;
 wrap(body,W/2,1000,900,65);

 ctx.fillStyle=accent;
 ctx.fillRect(220,1450,W-440,6);

 ctx.fillStyle=fg;
 ctx.font="bold 32px "+font;
 wrap(footer,W/2,1540,900,50);

 ctx.font="24px "+font;
 ctx.fillStyle=accent;
 ctx.fillText("DESIGNED WITH CREATIVITY",W/2,1650);

 function wrap(text,x,y,maxWidth,lineHeight){
   let words=text.split(/\s+/);
   let line="";
   let currentY=y;
   words.forEach(word=>{
     let test=line ? line+" "+word : word;
     if(ctx.measureText(test).width>maxWidth && line){
       ctx.fillText(line,x,currentY);
       line=word;
       currentY+=lineHeight;
     }else{
       line=test;
     }
   });
   if(line)ctx.fillText(line,x,currentY);
 }
}

function downloadPoster(){
 draw();
 const link=document.createElement("a");
 link.download="st-johns-poster.png";
 link.href=document.getElementById("poster").toDataURL("image/png");
 link.click();
}

ids.forEach(id=>{
 document.getElementById(id).addEventListener("input",draw);
});
draw();
</script>

</body>
</html>
